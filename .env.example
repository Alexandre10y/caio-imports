# Credenciais publicas do Supabase (seguras para o navegador).
# NUNCA coloque a service_role key aqui nem em qualquer arquivo do frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Keepalive do Supabase (somente servidor / Vercel Cron — nao vai pro bundle do Vite).
# Gere um token aleatorio longo e configure o mesmo valor na Vercel em CRON_SECRET.
CRON_SECRET=substitua-por-um-token-aleatorio-longo
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
